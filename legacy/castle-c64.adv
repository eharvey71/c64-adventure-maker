# Castle Adventure with USE Commands# Uses : instead of | for delimiters[SETTINGS]TITLE=THE HAUNTED CASTLEAUTHOR=C64 ADVENTUREVERSION=1.1STARTROOM=1MAXSCORE=150[ROOMS]# Format: ID:Name:Description:North,South,East,West:Special1:FOREST PATH:A WINDING DIRT PATH THROUGH DARK TREES.:0,2,0,0:2:CASTLE GATE:AN IMPOSING IRON GATE BLOCKS YOUR WAY.:1,3,0,0:3:COURTYARD:CRUMBLING STONE COURTYARD WITH A DRY FOUNTAIN.:2,4,5,0:4:GREAT HALL:A VAST HALL WITH TATTERED BANNERS.:3,0,0,0:5:KITCHEN:AN OLD KITCHEN WITH RUSTY POTS AND PANS.:0,0,0,3:6:SECRET PASSAGE:A NARROW STONE PASSAGE LIT BY TORCHES.:0,7,2,0:7:DUNGEON:A DANK UNDERGROUND CHAMBER.:6,8,0,0:8:TREASURE VAULT:THE CASTLE'S TREASURE VAULT! GOLD GLITTERS.:0,0,0,7:[OBJECTS]# Format: ID:StartRoom:Name:Description:PropertiesSWORD:1:RUSTY SWORD:AN OLD SWORD WITH A DULL BLADE.:TAKEABLEKEY:5:BRASS KEY:A SMALL ORNATE KEY.:TAKEABLEGATE:2:IRON GATE:A HEAVY GATE WITH A LARGE KEYHOLE.:FIXEDTREASURE:8:GOLDEN CHALICE:A MAGNIFICENT GOLDEN CHALICE!:TAKEABLE[VOCABULARY]# Synonyms for common wordsNORTH=NSOUTH=SEAST=EWEST=WTAKE=GET,GRABEXAMINE=X,LOOK[MESSAGES]# Standard game messagesINVENTORY_EMPTY=YOU AREN'T CARRYING ANYTHING.CANT_GO=YOU CAN'T GO THAT WAY.DONT_UNDERSTAND=I DON'T UNDERSTAND THAT.NOT_HERE=I DON'T SEE THAT HERE.WIN_GAME=CONGRATULATIONS! YOU HAVE WON![RESPONSES]# Format: COMMAND:CONDITION:MESSAGE:ACTIONUSE KEY GATE:HAS KEY:THE KEY TURNS IN THE LOCK! THE GATE CREAKS OPEN. A SECRET PASSAGE IS REVEALED!:UNLOCK WEST 2 TO 6USE KEY:HAS KEY:THE KEY GLINTS IN THE LIGHT.:USE SWORD:HAS SWORD:YOU WAVE THE SWORD AROUND MENACINGLY.:EXAMINE GATE::THE GATE HAS A LARGE KEYHOLE.:EXAMINE KEY:HAS KEY:THE KEY LOOKS LIKE IT MIGHT FIT THE GATE.: